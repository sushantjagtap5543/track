PORT=3001
NODE_ENV=development

# Database connection (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Redis connection (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Traccar API connection
TRACCAR_URL=http://localhost:8082
TRACCAR_ADMIN_EMAIL=admin@example.com
TRACCAR_ADMIN_PASSWORD=admin

# Authentication
JWT_SECRET=supersecretjwtkey_geosurepath_2026
JWT_EXPIRATION=7d

# Third Party (Razorpay, Nodemailer, WhatsApp etc...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
