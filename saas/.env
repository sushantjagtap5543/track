PORT=3001
NODE_ENV=development

# Database connection (Prisma)
DATABASE_URL="postgresql://${DB_USER:-geosurepath}:${DB_PASSWORD}@db:5432/${DB_NAME:-geosurepath}?schema=saas"

# Redis connection (BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# GeoSurePath API connection
GEOSUREPATH_URL=http://geosurepath:8082
GEOSUREPATH_ADMIN_EMAIL=admin@example.com
GEOSUREPATH_ADMIN_PASSWORD=admin

# Authentication
JWT_SECRET=supersecretjwtkey_geosurepath_2026
JWT_EXPIRATION=7d

# Third Party (Razorpay, Nodemailer, WhatsApp etc...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
