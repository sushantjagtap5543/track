generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum PlanType {
  MONTHLY
  YEARLY
}

enum AlertType {
  STAY_DURATION
  SPEED
  AREA_STAY
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  phone         String?
  password      String
  role          Role      @default(CLIENT)
  geosurepathUserId Int?      @unique
  isActive      Boolean   @default(true)
  loginHistory  LoginHistory[]
  vehicles      Vehicle[]
  subscriptions Subscription[]
  payments      Payment[]
  notifications Notification[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Vehicle {
  id              String   @id @default(uuid())
  name            String
  imei            String   @unique
  type            String?
  model           String?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  geosurepathDeviceId Int?     @unique
  geosurepathGeofenceId Int?   @unique
  safeParkingOn   Boolean  @default(false)
  parkingLat      Float?
  parkingLng      Float?
  parkingRadius   Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  alertRules      AlertRule[]
}

model Subscription {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        SubscriptionStatus @default(ACTIVE)
  planId        String?
  plan          Plan?              @relation(fields: [planId], references: [id])
  price         Float
  deviceCount   Int                @default(1)
  expiresAt     DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Plan {
  id              String         @id @default(uuid())
  name            String
  description     String?
  pricePerDevice  Float
  billingCycle    PlanType       @default(MONTHLY)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
}

model AlertRule {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        AlertType
  parameters  Json     // e.g. { "duration": 30, "geofenceId": 123 }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  status        String   @default("PENDING")
  transactionId String?
  paymentMethod String?
  createdAt     DateTime @default(now())
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  device    String?
  success   Boolean
  createdAt DateTime @default(now())
}
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // e.g. "SAFE_PARKING_BREACH", "TAMPERING", "ENGINE_CONTROL"
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
