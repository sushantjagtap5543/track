generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanType {
  MONTHLY
  YEARLY
}

enum AlertType {
  STAY_DURATION
  SPEED
  AREA_STAY
}

model User {
  id                  String         @id @default(uuid())
  name                String
  username            String?        @unique
  email               String         @unique
  phone               String?
  password            String
  role                String         @default("CLIENT")
  avatarUrl           String?
  timezone            String         @default("UTC")
  permissions         Json?
  geosurepathUserId   Int?           @unique
  isActive            Boolean        @default(true)
  isVerified          Boolean        @default(false)
  registrationDate    DateTime       @default(now())
  loginAttempts       Int            @default(0)
  lockUntil           DateTime?
  lastLoginAt         DateTime?
  resetToken          String?
  resetTokenExpires   DateTime?
  deletedAt           DateTime?
  loginHistory        LoginHistory[]
  vehicles            Vehicle[]
  subscriptions       Subscription[]
  payments            Payment[]
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  refreshTokens       RefreshToken[]
  fleets              Fleet[]
  graceExtensionUntil DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  auditLogs           AuditLog[]

  @@index([role, isActive])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Vehicle {
  id                    String       @id @default(uuid())
  name                  String
  imei                  String       @unique
  type                  String?
  model                 String?
  plate                 String?
  isActive              Boolean      @default(true)
  deletedAt             DateTime?
  metadata              Json?
  userId                String
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fleetId               String?
  fleet                 Fleet?       @relation(fields: [fleetId], references: [id])
  geosurepathDeviceId   Int?         @unique
  geosurepathGeofenceId Int?         @unique
  registrationDate      DateTime     @default(now())
  safeParkingOn         Boolean      @default(false)
  parkingLat            Float?
  parkingLng            Float?
  parkingRadius         Float?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  alertRules            AlertRule[]
  vehicleLogs           VehicleLog[]

  @@index([userId])
  @@index([fleetId])
}

model Fleet {
  id        String    @id @default(uuid())
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model VehicleLog {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  action    String // e.g. "STATUS_CHANGE", "METADATA_UPDATE"
  details   String?
  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model Subscription {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String   @default("ACTIVE")
  planId      String?
  plan        Plan?    @relation(fields: [planId], references: [id])
  price       Float
  deviceCount Int      @default(1)
  expiresAt   DateTime
  invoiceId   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([invoiceId])
}

model Plan {
  id             String         @id @default(uuid())
  name           String
  description    String?
  pricePerDevice Float
  billingCycle   PlanType       @default(MONTHLY)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subscriptions  Subscription[]
}

model AlertRule {
  id         String    @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type       AlertType
  parameters Json // e.g. { "duration": 30, "geofenceId": 123 }
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  status        String   @default("PENDING") // PENDING, CAPTURED, FAILED
  transactionId String?
  paymentMethod String?
  
  // Razorpay Integration
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?
  
  planId            String? // Store plan ID to create subscription on capture
  subscriptionId    String? // Link to subscription if created via payment
  
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([razorpayOrderId])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  device    String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // e.g. "SAFE_PARKING_BREACH", "TAMPERING", "ENGINE_CONTROL"
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([isRead])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String? // android, ios, web
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AdminSetting {
  id          String   @id @default("GLOBAL")
  paymentLink String?
  
  // Razorpay
  razorpayId            String?
  razorpaySecret        String?
  razorpayWebhookSecret String?
  
  // Firebase
  firebaseConfig String? // Store as JSON string or Server Key
  
  // AI/OpenRouter
  openrouterKey String?
  
  // System Contact
  supportEmail String?

  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?
  userId    String?
  action    String // e.g. "LOCK_USER", "EXTEND_GRACE", "MANUAL_INVOICE"
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
}

// Global user index for all relevant models
// Note: This was incorrectly placed inside the last model
// Moved to its own section or just removed if it's redundant (User already has email index)
// Actually, it seems they wanted an index on User's certain field, but @@index([userId]) 
// inside a model would mean it's an index for THAT model's userId field.
// Let's put a proper index back where it makes sense (e.g. DeviceToken)
