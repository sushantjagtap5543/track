# GeoSurePath SaaS - Enterprise GPS Tracking Ecosystem
# .env file for Docker Deployment

# ==========================================
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
DB_USER=geosurepath
DB_PASSWORD=change-this-to-something-very-strong-and-unique
DB_NAME=geosurepath
DB_HOST=db
DB_PORT=5432

# ==========================================
# 2. REDIS CONFIGURATION (BullMQ / Queue)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# 3. SAAS API CONFIGURATION
# ==========================================
PORT=3001
# Use a long random string for security
JWT_SECRET=ronA34g6dOpNRHCDNHw7AX3ANqqaXzbsAVs8XTIHTSxjk7aCEBE7DdfBHNqXP3OMtKXsV6znZCDlvCXPEgnRPN
JWT_EXPIRATION=365d

# List of allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,*

# ==========================================
# 4. TRACCAR CORE (GEOSUREPATH ENGINE)
# ==========================================
GEOSUREPATH_URL=http://geosurepath:8082
# Credentials for SaaS API to talk to Traccar Core
GEOSUREPATH_ADMIN_EMAIL=admin@example.com
GEOSUREPATH_ADMIN_PASSWORD=admin-password-from-seeding

# ==========================================
# 5. AI-GUARDIAN & EXTERNAL INTEGRATIONS
# ==========================================
# Get your key from openrouter.ai
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=openrouter/free

# Google Drive / Apps Script Webhook for automated backups
